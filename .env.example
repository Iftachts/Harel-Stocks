# =============================================================================
# Harel Terminal - environment
#   cp .env.example .env && set -a && source .env && set +a
# =============================================================================

# REQUIRED. The SEC blocks clients that do not identify themselves with a
# contact address. Without this, EDGAR - the most valuable source in the
# system - will return 403.
SEC_CONTACT_EMAIL=you@example.com

# ---------------------------------------------------------------- optional --

# TASE / MAYA official API. Register free at https://openapi.tase.co.il
# Without it the MAYA collector still runs, but on undocumented public
# endpoints that can change without notice. See docs/LIMITATIONS.md section 3.
# TASE_API_KEY=

# FCC ECFS. Free key from https://api.data.gov/signup/
# Only useful for GILT (satcom spectrum filings).
# FCC_API_KEY=

# CourtListener / RECAP. Free token from https://www.courtlistener.com/
# Patent (Paragraph IV) and securities litigation dockets - mainly TEVA.
# COURTLISTENER_TOKEN=

# openFDA works keyless at 240 requests/minute. A free key raises the limit.
# https://open.fda.gov/apis/authentication/
# OPENFDA_API_KEY=

# ------------------------------------------------------------------- paid --

# Analyst rating changes. The single largest quality gap vs Bloomberg.
# Also set enabled: true on benzinga_ratings in config/sources.yaml.
# BENZINGA_API_KEY=

# Finnhub. Free tier covers the earnings calendar; ratings need a paid plan.
# Also set enabled: true on finnhub in config/sources.yaml.
# FINNHUB_API_KEY=

# ------------------------------------------------------------------ paths --
# HAREL_DATA_DIR=./data
# HAREL_CONFIG_DIR=./config
